{
  "name": "fixit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.domain.json",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:restart": "node scripts/verify-restart.mjs",
    "test:migration": "node scripts/verify-migration-preflight.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "gpt-tokenizer": "4.1.2",
    "lucide-react": "^1.17.0",
    "mongoose": "8.24.9",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "openai": "7.59.0",
    "react": "19.0.9",
    "react-dom": "19.0.9",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.65.1",
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "axe-core": "4.14.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "mongodb-memory-server": "11.3.0",
    "postcss": "^8",
    "prettier": "3.8.1",
    "tailwindcss": "^3.4.1",
    "typescript": "5.7.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24 <25"
  },
  "resolutions": {
    "next/postcss": "8.5.33"
  }
}
