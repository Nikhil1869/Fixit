# Local development only. Never paste production credentials into this file.
MONGODB_URI=mongodb://127.0.0.1:27017/fixit_development
AUTH_SECRET=replace-with-a-new-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000
# Only enable behind a trusted reverse proxy that sanitizes Host headers.
AUTH_TRUST_HOST=false

# Optional generative AI. Server-only; never use NEXT_PUBLIC_ prefixes.
# Keep empty until a provider account/key and a tool-capable model are configured.
AI_PROVIDER=groq
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1
# Set true only after verifying Free plan and selected model access in Groq Console.
# This is your attestation, not independent provider/billing verification.
AI_FREE_PLAN_CONFIRMED=false
